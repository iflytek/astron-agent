      "css": ".ds-search{width:300px;max-width:100%;height:38px;padding:0 11px;border:1px solid var(--console-line);border-radius:7px;background:#fff;color:var(--console-ink);font:14px var(--console-font);caret-color:var(--console-primary)}.ds-search::placeholder{color:var(--console-muted);opacity:1}.ds-search:hover{border-color:var(--console-primary)}.ds-search:focus-visible{outline:2px solid var(--console-primary);outline-offset:3px;}"
    },
    {
      "name": "Context navigation",
      "kind": "nav",
      "refersTo": "nav-item-active",
      "description": "当前模块内的上下文链接。",
      "html": "<nav class=\"ds-nav\" aria-label=\"应用构建\"><a class=\"ds-nav-item ds-current\" href=\"#agent\" aria-current=\"page\">Agent</a><a class=\"ds-nav-item\" href=\"#workflow\">工作流</a></nav>",
      "css": ".ds-nav{width:172px;padding:12px;background:var(--console-context);font:14px/1.5 var(--console-font)}.ds-nav-item{display:flex;min-height:42px;align-items:center;padding:0 12px;border-radius:6px;color:var(--console-ink);text-decoration:none;margin-bottom:4px}.ds-nav-item:hover{background:#eaf0fc}.ds-nav-item.ds-current{background:#e7eeff;color:var(--console-primary);font-weight:600}.ds-nav-item:focus-visible{outline:2px solid var(--console-primary);outline-offset:-3px}"
    },
    {
      "name": "Resource chip",
      "kind": "chip",
      "refersTo": "resource-chip",
      "description": "显示真实关联资源的非交互徽标。",
      "html": "<span class=\"ds-chip\">已配置模型</span>",
      "css": ".ds-chip{display:inline-flex;gap:5px;max-width:100%;overflow-wrap:anywhere;background:#f2f5fb;color:#52688c;padding:3px 8px;border-radius:5px;font:12px/19px var(--console-font)}"
    },
    {
      "name": "Resource card",
      "kind": "card",
      "refersTo": "resource-card",
      "description": "名称、用途、资源和底部动作组成目录单元。",
      "html": "<article class=\"ds-card\"><a class=\"ds-card-title\" href=\"#edit\">客户支持 Agent</a><span class=\"ds-card-type\">独立 Agent</span><p class=\"ds-card-description\">连接模型与知识库，处理客户支持任务。</p><div class=\"ds-card-resources\"><span class=\"ds-card-chip\">已配置模型</span></div><footer class=\"ds-card-footer\"><span>独立 Agent</span><a href=\"#edit\">编辑与调试</a></footer></article>",
      "css": ".ds-card{display:flex;flex-direction:column;min-height:266px;padding:22px 24px 0;border:1px solid var(--console-line);border-radius:14px;background:#fff;color:var(--console-ink);font:14px/1.5 var(--console-font);transition:border-color .18s ease-out}.ds-card:hover,.ds-card:focus-within{border-color:#8aa5f5}.ds-card-title{color:inherit;text-decoration:none;font-size:20px;line-height:28px;font-weight:600;letter-spacing:-.02em}.ds-card-title:hover{color:var(--console-primary)}.ds-card-type{color:var(--console-muted);font-size:12px;line-height:20px}.ds-card-description{margin:16px 0 14px;min-height:46px;color:#526580;line-height:23px}.ds-card-resources{margin-bottom:20px}.ds-card-chip{display:inline-flex;padding:3px 8px;background:#f2f5fb;color:#52688c;border-radius:5px;font-size:12px;line-height:19px}.ds-card-footer{margin-top:auto;min-height:54px;padding:12px 0;border-top:1px solid #e8edf5;display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;color:var(--console-muted);font-size:12px}.ds-card-footer a{font-size:13px;font-weight:500;color:#3159d9;text-decoration:none}.ds-card-footer a:hover{text-decoration:underline;text-underline-offset:4px}.ds-card a:focus-visible{outline:2px solid var(--console-primary);outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-card{transition:none}}"
    },
    {
