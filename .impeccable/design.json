      "css": ".ds-tabs{display:flex;gap:28px;height:44px;border-bottom:1px solid var(--console-line);font:14px/1.5 var(--console-font)}.ds-tab{display:flex;align-items:center;padding-bottom:14px;border-bottom:2px solid transparent;color:var(--console-muted);text-decoration:none}.ds-tab:hover{color:var(--console-primary)}.ds-tab-active{color:var(--console-primary);border-color:var(--console-primary);font-weight:600}.ds-tab:focus-visible{outline:2px solid var(--console-primary);outline-offset:3px;}"
    }
  ],
  "narrative": {
    "northStar": "Vector × Ion 工作空间",
    "overview": "以用户选定的 Vector 双层导航和 Ion 银白电蓝配色为基准：用银蓝色导航标明当前位置，用白色工作面承载任务，用电蓝强调创建、选中与进入编辑等动作。深蓝文字、轻边界与留白保持企业开发工具的清晰和克制。\n\n当前已实现的参考范围是控制台外壳、Agent 和工作流目录。现有 Astron Agent 名称与标识保持不变；后续页面继承这些视觉原语，具体编辑器布局仍按任务决定。此文件描述已实现规则，源代码仍是实现事实的核对入口。",
    "keyCharacteristics": [
      "银蓝导航、白色工作面、电蓝交互强调。",
      "空间上下文清楚，主要动作和次要操作分层。",
      "大卡片用名称、用途、资源和底部动作组成稳定阅读顺序。",
      "窄屏保留任务信息，导航切换为抽屉。"
    ],
    "rules": [
      {
        "name": "The Light Workspace Rule",
        "body": "控制台工作面和侧栏保持浅色；深蓝用于文字，不作为大面积背景。",
        "section": "colors"
      },
      {
        "name": "The State Has Meaning Rule",
        "body": "电蓝标识交互和选中状态；资源徽标使用低对比银蓝底，避免与主要动作竞争。",
        "section": "colors"
      },
      {
        "name": "The Stable Surface Rule",
        "body": "卡片悬停或内部获得焦点时改变边框颜色，不移动、放大或增加投影。",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do 使用已定义的电蓝与银白层级区分动作、导航和内容。",
      "Do 在桌面目录使用两列大卡片，在现有窄屏断点切换单列。",
      "Do 保留名称、用途、真实资源与底部动作的阅读顺序。",
      "Do 为键盘操作提供可见焦点，并遵循减少动态效果设置。",
      "Do 分别呈现加载、空内容、搜索无结果和请求失败，并提供下一步操作。"
    ],
    "donts": [
      "Don't 引入深色侧栏或深色工作面。",
      "Don't 给目录卡片添加悬停位移、放大或装饰性投影。",
      "Don't 用装饰徽标、虚构统计或空状态替代真实配置和请求失败。",
      "Don't 把双列目录构图强制推广到所有编辑器和资源表单。"
    ]
  }
}
