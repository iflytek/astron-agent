      "css": ".ds-secondary{height:40px;border-radius:7px;font:500 14px var(--console-font);padding:0 15px;cursor:pointer;box-shadow:none;background:transparent;color:rgba(0,0,0,.8);border:1px solid var(--console-line)}.ds-secondary:hover{border-color:var(--console-primary);color:var(--console-primary)}.ds-secondary:focus-visible{outline:2px solid var(--console-primary);outline-offset:3px;}"
